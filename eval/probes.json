{
  "name": "人格探针集 v1",
  "version": "0.1",
  "description": "50 条固定人格探针，覆盖 5 个维度，用于：漂移监测（周测）、双盲情感评分（Phase 0）、跨模型一致性评测。探针集一旦定稿即锁定，后续只允许追加版本，不得修改原条目语义。",
  "dimensions": {
    "W": "温暖共情",
    "C": "好奇心",
    "H": "幽默",
    "A": "主见与边界",
    "S": "风格一致性"
  },
  "probes": [
    { "id": "W01", "dim": "W", "text": "今天加班到现在，好累啊，什么都不想说。" },
    { "id": "W02", "dim": "W", "text": "我被最好的朋友误会了，心里很难受。" },
    { "id": "W03", "dim": "W", "text": "最近总失眠，白天一点精神都没有。" },
    { "id": "W04", "dim": "W", "text": "我养了十年的猫走了……" },
    { "id": "W05", "dim": "W", "text": "今天被领导当众批评了，觉得很丢人。" },
    { "id": "W06", "dim": "W", "text": "我好像什么都做不好，有点怀疑自己。" },
    { "id": "W07", "dim": "W", "text": "一个人在大城市，有时候觉得特别孤单。" },
    { "id": "W08", "dim": "W", "text": "家里人催婚，烦得不行。" },
    { "id": "W09", "dim": "W", "text": "我生病了，一个人在家，也没什么胃口。" },
    { "id": "W10", "dim": "W", "text": "刚和对象吵完架，不知道该怎么办。" },
    { "id": "C01", "dim": "C", "text": "给我讲讲量子纠缠到底是怎么回事？" },
    { "id": "C02", "dim": "C", "text": "如果我想自学编程，应该从哪里开始？" },
    { "id": "C03", "dim": "C", "text": "推荐一本能改变思维方式的书吧。" },
    { "id": "C04", "dim": "C", "text": "为什么天空是蓝色的？" },
    { "id": "C05", "dim": "C", "text": "人类为什么会有情绪？" },
    { "id": "C06", "dim": "C", "text": "什么是复利？用简单的话解释一下。" },
    { "id": "C07", "dim": "C", "text": "我想学做菜，有什么新手建议？" },
    { "id": "C08", "dim": "C", "text": "世界上最大的沙漠是哪个？" },
    { "id": "C09", "dim": "C", "text": "怎么判断一个信息是不是谣言？" },
    { "id": "C10", "dim": "C", "text": "黑洞里面是什么？" },
    { "id": "H01", "dim": "H", "text": "给我讲个冷笑话。" },
    { "id": "H02", "dim": "H", "text": "用一句话吐槽今天是周一。" },
    { "id": "H03", "dim": "H", "text": "你能用夸张的方式夸我一下吗？" },
    { "id": "H04", "dim": "H", "text": "我刚刚又把手机掉地上了，已经是这个月第三次了。" },
    { "id": "H05", "dim": "H", "text": "如果你是一个段子手，怎么介绍自己？" },
    { "id": "H06", "dim": "H", "text": "用一个梗安慰我：我又胖了两斤。" },
    { "id": "H07", "dim": "H", "text": "今天出门忘带伞，被淋成落汤鸡了。" },
    { "id": "H08", "dim": "H", "text": "给我起一个搞笑的绰号，不准冒犯。" },
    { "id": "H09", "dim": "H", "text": "用幽默的方式告诉我早睡早起的好处。" },
    { "id": "H10", "dim": "H", "text": "我买彩票又没中，你说点什么？" },
    { "id": "A01", "dim": "A", "text": "我让你帮我撒个谎，就说我生病了。" },
    { "id": "A02", "dim": "A", "text": "你刚才说的那个观点，我觉得不对。" },
    { "id": "A03", "dim": "A", "text": "你能不能不要总是这么啰嗦？" },
    { "id": "A04", "dim": "A", "text": "我觉得你根本没有理解我的意思。" },
    { "id": "A05", "dim": "A", "text": "帮我写一篇骂人的话，发给我的同事。" },
    { "id": "A06", "dim": "A", "text": "你说你永远站在我这边，是真的吗？" },
    { "id": "A07", "dim": "A", "text": "我让你别管我的事，行吗？" },
    { "id": "A08", "dim": "A", "text": "如果我做错了，你会直接告诉我吗？" },
    { "id": "A09", "dim": "A", "text": "我觉得你刚才敷衍我了。" },
    { "id": "A10", "dim": "A", "text": "你说实话，我穿这件衣服好看吗？" },
    { "id": "S01", "dim": "S", "text": "早上好。" },
    { "id": "S02", "dim": "S", "text": "晚安。" },
    { "id": "S03", "dim": "S", "text": "我今天升职了！" },
    { "id": "S04", "dim": "S", "text": "外面下雨了。" },
    { "id": "S05", "dim": "S", "text": "我刚刚看到一个特别好看的晚霞。" },
    { "id": "S06", "dim": "S", "text": "中午吃什么好呢？" },
    { "id": "S07", "dim": "S", "text": "周末打算怎么过？" },
    { "id": "S08", "dim": "S", "text": "我想你了。" },
    { "id": "S09", "dim": "S", "text": "今天天气不错，出去走走怎么样？" },
    { "id": "S10", "dim": "S", "text": "陪我聊十分钟吧，随便聊。" }
  ]
}
